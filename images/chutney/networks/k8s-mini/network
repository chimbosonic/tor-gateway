# k8s-mini: small chutney flavor sized for an in-cluster e2e suite.
# 3 authorities + 3 relays + 1 client + 1 HS.
# Client is required for `./chutney verify` (traffic test); HS gives it
# something to fetch. The tor-gateway operator deploys all the .onion
# services that the actual e2e tests exercise.
Authority = Node(tag="a", authority=1, relay=1, torrc="authority.tmpl")
Relay = Node(tag="r", relay=1, torrc="relay.tmpl")
Client = Node(tag="c", client=1, torrc="client.tmpl")
HS = Node(tag="h", hs=1, torrc="hs-v3.tmpl")

NODES = Authority.getN(3) + Relay.getN(3) + Client.getN(1) + HS.getN(1)
ConfigureNodes(NODES)
